#!/usr/bin/env bash
set -Eeuo pipefail
script_path="$(realpath "${BASH_SOURCE[0]}")"
aiteam_home="$(cd "$(dirname "$script_path")/.." && pwd)"

repo=""
port="${AITEAM_WATCH_PORT:-}"
host="${AITEAM_WATCH_HOST:-127.0.0.1}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --port|-p)
      port="$2"; shift 2 ;;
    --host|-h)
      host="$2"; shift 2 ;;
    --repo|-r)
      repo="$2"; shift 2 ;;
    *)
      if [[ -z "$repo" ]]; then repo="$1"; fi; shift ;;
  esac
done

repo="${repo:-$PWD}"
if [[ -n "$port" ]]; then
  exec node "$aiteam_home/src/watch-server.mjs" --repo "$repo" --host "$host" --port "$port"
else
  exec node --input-type=module -e "
    import { ensureWatcher } from '$aiteam_home/src/watcher-discovery.mjs';
    import path from 'node:path';
    const repo = path.resolve(process.argv[1]);
    const url = await ensureWatcher(repo);
    console.log('AITEAM watch: ' + url + '/');
    console.log('Repository: ' + repo);
  " "$repo"
fi
