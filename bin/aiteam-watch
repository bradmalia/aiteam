#!/usr/bin/env bash
set -Eeuo pipefail
script_path="$(realpath "${BASH_SOURCE[0]}")"
aiteam_home="$(cd "$(dirname "$script_path")/.." && pwd)"

repo=""
port="${AITEAM_WATCH_PORT:-4317}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --port|-p)
      port="$2"; shift 2 ;;
    --repo|-r)
      repo="$2"; shift 2 ;;
    *)
      if [[ -z "$repo" ]]; then repo="$1"; fi; shift ;;
  esac
done

repo="${repo:-$PWD}"
exec node "$aiteam_home/src/watch-server.mjs" --repo "$repo" --port "$port"
