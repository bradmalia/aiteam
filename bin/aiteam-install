#!/usr/bin/env bash
set -Eeuo pipefail

# AITeam Skill Project Installer
# Links the AITeam Skill into any repository, refreshes AGENTS.md, creates .aiteam state
# directory, writes .aiteam/install.json, and configures git exclusion.

target_repo="${1:-$PWD}"
target_repo="$(cd "$target_repo" && pwd)"
script_path="$(realpath "${BASH_SOURCE[0]}")"
aiteam_home="$(cd "$(dirname "$script_path")/.." && pwd)"

echo "=== Installing AITeam Skill into $target_repo ==="
node "$aiteam_home/skill/lib/upgrader.mjs" install --repo "$target_repo"
echo "=== AITeam Skill successfully installed into $target_repo ==="
echo "Launch or discover the live watcher anytime with:"
echo "  $aiteam_home/bin/aiteam-watch \"$target_repo\""
